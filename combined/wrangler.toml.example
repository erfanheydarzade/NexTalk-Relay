name = "nextalk-relay"
main = "worker.js"
compatibility_date = "2026-06-10"

# Combined single-Worker deployment — shard + router logic in one process.
# Use this when you want the simplest possible setup: one Worker, one KV
# namespace, no separate router instance. The combined worker handles
# /create, /send, /read, /health (shard paths) AND /register, /resolve,
# /routing_table.json (router paths) in the same script.
#
# For a scalable multi-shard mesh, deploy shard/ and router/ separately.

# One KV namespace for all mailbox + routing state. Create with:
#   wrangler kv namespace create MAILBOX_KV
[[kv_namespaces]]
binding = "MAILBOX_KV"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

# Optional: bind a separate admin KV (same semantics as router/wrangler.toml.example).
# If omitted, shard topology is fully static (read only from [vars] below).
# [[kv_namespaces]]
# binding = "ROUTER_ADMIN_KV"
# id = "REPLACE_WITH_YOUR_ADMIN_KV_NAMESPACE_ID"

# Periodically pushes the signed routing table out to registered shards.
# Only meaningful when you have external shards registered; safe to keep
# enabled even with a single-node setup (it's a no-op when SHARD_URLS is empty).
[triggers]
crons = ["*/10 * * * *"]

[vars]
# Public half of ROUTER_SIGNING_KEY — safe to commit. Generated by:
#   python3 scripts/generate.py
ROUTER_SIGNING_PUBLIC = "REPLACE_WITH_YOUR_ED25519_PUBLIC_KEY_HEX"

# Static shard list — usually just this worker's own URL for a standalone setup.
# Append-only: never reorder or remove existing entries.
SHARD_URLS = "[]"
PRIOR_SHARD_COUNTS = "[]"
ROUTING_TABLE_VERSION = "1"
REPLICATION_FACTOR = "1"

# PoW difficulty for shard self-registration (bits of leading zeros).
SHARD_POW_DIFFICULTY_BITS = "20"
MAX_REGISTERED_SHARDS = "200"

# Tunable mailbox limits — all optional, defaults are shown here.
MAX_MESSAGES = "50"
MAX_MSG_BYTES = "32768"
TTL_SECONDS = "1209600"           # 14 days  — unread MESSAGE backlog TTL
MAILBOX_TTL_SECONDS = "31536000"  # 365 days — whole MAILBOX record TTL, sliding
MAX_CLOCK_SKEW = "30000"          # 30 seconds
MAX_SENDS_PER_SENDER = "30"
MAX_SENDS_PER_TARGET = "60"
MAX_SENDS_PER_IP = "120"
MAX_CREATES_PER_IP = "20"
MAX_REPLICATES_PER_ORIGIN = "200"

# Secrets (never commit real values — set via `wrangler secret put <NAME>`):
#
#   SERVER_SECRET          required — HMAC key for deriving mailbox IDs from pubkeys
#   ROUTER_SIGNING_KEY     required — Ed25519 private key (PKCS8, base64) for signing
#                                     routing tables and capabilities
#   ROUTER_SHARED_SECRET   optional — protects /status and admin endpoints
#
# Generate all three in one shot:
#   python3 scripts/generate.py
#
# Then:
#   wrangler secret put SERVER_SECRET
#   wrangler secret put ROUTER_SIGNING_KEY
#   wrangler secret put ROUTER_SHARED_SECRET
